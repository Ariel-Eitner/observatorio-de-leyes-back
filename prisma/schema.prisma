generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TrackingEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  type       String
  sessionId  String   @map("session_id")
  guestId    String?  @map("guest_id")
  userId     String?  @map("user_id")
  properties Json?
  context    Json?

  @@index([createdAt(sort: Desc)], map: "idx_te_created_at")
  @@index([guestId], map: "idx_te_guest")
  @@index([userId], map: "idx_te_user")
  @@index([guestId, createdAt(sort: Desc)], map: "idx_te_guest_created")
  @@index([sessionId], map: "idx_te_session")
  @@index([type], map: "idx_te_type")
  @@index([type, createdAt(sort: Desc)], map: "idx_te_type_date")
  @@map("tracking_events")
}

// Tráfico de crawlers agregado por día. Los bots eran el 80% de tracking_events;
// ahora se descartan al ingresar (ver common/bots.ts) y solo se cuentan acá, para
// no perder la señal de cuánto nos crawlean sin pagar el costo de guardar cada hit.
model BotTrafficDaily {
  day  DateTime @db.Date
  bot  String
  hits BigInt   @default(0)

  @@id([day, bot])
  @@map("bot_traffic_daily")
}

model ExportGeneration {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guestId   String   @map("guest_id")
  type      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([guestId, type], map: "export_generations_guest_type_idx")
  @@map("export_generations")
}

model PostDraft {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  platform      String   @default("twitter")
  postText      String   @map("post_text")
  commentText   String   @map("comment_text")
  lawId         String   @map("law_id")
  lawTitle      String   @map("law_title")
  articleNumber String   @map("article_number")
  utmContent    String   @map("utm_content")
  templateUsed  String   @map("template_used")
  hashtags      String   @default("")

  @@index([platform, createdAt(sort: Desc)], map: "idx_post_drafts_platform")
  @@map("post_drafts")
}

model PostedLawHistory {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lawId         String   @map("law_id")
  articleNumber String   @map("article_number")
  platform      String   @default("twitter")
  postedAt      DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)

  @@index([lawId, articleNumber, platform], map: "idx_posted_history_lookup")
  @@map("posted_law_history")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model contact_submissions {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  nombre            String
  email             String?
  tipo              String
  mensaje           String
  user_agent        String?
  is_read           Boolean   @default(false)
  apellido          String?
  telefono          String?
  profesion         String?
  utm_source        String?
  utm_medium        String?
  utm_campaign      String?
  utm_content       String?
  utm_term          String?
  empresa           String?
  provincia         String?
  como_nos_encontro String?
  tipo_usuario      String?
  guest_id          String?
  consent_at        DateTime? @db.Timestamptz(6)
  consent_version   String?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model founders {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
  nombre          String
  email           String    @unique
  canal           String?
  confirmed_at    DateTime? @db.Timestamptz(6)
  utm_source      String?
  utm_medium      String?
  utm_campaign    String?
  utm_content     String?
  utm_term        String?
  pagado          Boolean?  @default(false)
  comprobante_url String?
  comprobante_at  DateTime? @db.Timestamptz(6)
  telefono        String?
  // Beneficio Pro para donantes verificados: se otorga a mano desde el panel.
  beneficio             String?
  beneficio_meses       Int?
  beneficio_otorgado_at DateTime? @db.Timestamptz(6)
  beneficio_hasta       DateTime? @db.Timestamptz(6)
  beneficio_nota        String?
  guest_id        String?
  mensaje         String?
  nivel           String?
  oculto_muro     Boolean   @default(false)
  // Prueba de consentimiento (ley 25.326). Bumpear CONSENT_VERSION al cambiar el texto.
  consent_at      DateTime? @db.Timestamptz(6)
  consent_version String?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model lead_events {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id    String    @db.Uuid
  type       String
  payload    Json?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  leads      leads     @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)])
  @@index([lead_id])
  @@index([type])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model leads {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String?       @unique
  nombre            String?
  created_at        DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?     @default(now()) @db.Timestamptz(6)
  first_source      String        @default("unknown")
  status            String        @default("cold")
  utm_source        String?
  utm_medium        String?
  utm_campaign      String?
  utm_content       String?
  utm_term          String?
  notes             String?
  tipo_usuario      String?
  profesion         String?
  empresa           String?
  provincia         String?
  telefono          String?
  como_nos_encontro String?
  guest_id          String?
  device            String?
  // Prueba de consentimiento (ley 25.326).
  consent_at        DateTime?     @db.Timestamptz(6)
  consent_version   String?
  lead_events       lead_events[]

  @@index([created_at(sort: Desc)])
  @@index([first_source])
  @@index([provincia])
  @@index([status])
  @@index([tipo_usuario])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tracking_daily_summary {
  date          DateTime @id @db.Date
  sessions      Int      @default(0)
  guests        Int      @default(0)
  page_views    Int      @default(0)
  searches      Int      @default(0)
  zero_searches Int      @default(0)
  law_views     Int      @default(0)
  art_copies    Int      @default(0)
  amendments    Int      @default(0)
  inline_refs   Int      @default(0)
  contacts_sent Int      @default(0)
  errors_404    Int      @default(0)
  raw_total     Int      @default(0)
}

model Egreso {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha       DateTime @db.Date
  proveedor   String
  categoria   String   // INFRA | HERRAMIENTAS | HONORARIOS | PUBLICIDAD | EQUIPO | IMPUESTOS | OTRO
  descripcion String?
  monto       Float
  moneda      String   @default("USD") // ARS | USD
  tipoCambio  Float?   @map("tipo_cambio")
  montoArs    Float?   @map("monto_ars")
  comprobante String?
  estado      String   @default("pagado") // pagado | pendiente
  recurrente  Boolean  @default(false)
  mesesPagados String[] @default([]) @map("meses_pagados") // recurrentes: meses "YYYY-MM" marcados como pagados
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([fecha(sort: Desc)], map: "idx_egresos_fecha")
  @@index([categoria], map: "idx_egresos_categoria")
  @@map("egresos")
}

model Ingreso {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha       DateTime @db.Date
  tipo        String   // SUSCRIPCION | DONACION | SERVICIO | OTRO
  plan        String?
  cliente     String?
  descripcion String?
  monto       Float
  moneda      String   @default("USD") // ARS | USD
  tipoCambio  Float?   @map("tipo_cambio")
  montoArs    Float?   @map("monto_ars")
  medioCobro  String   @default("STRIPE") @map("medio_cobro") // MERCADOPAGO | STRIPE | TRANSFERENCIA | EFECTIVO | OTRO
  facturaAfip String?  @map("factura_afip")
  periodo     String?  // "2026-05"
  sourceRef   String?  @unique @map("source_ref") // dedupe de ingresos creados desde un pago
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([fecha(sort: Desc)], map: "idx_ingresos_fecha")
  @@index([tipo], map: "idx_ingresos_tipo")
  @@map("ingresos")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tweets_performance {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha           DateTime @db.Date
  tipo            String
  url             String?
  texto_preview   String?
  impresiones     Int      @default(0)
  replies         Int      @default(0)
  bookmarks       Int      @default(0)
  retweets        Int      @default(0)
  link_clicks     Int      @default(0)
  follows_ganados Int      @default(0)
  notas           String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  subtweets       Json     @default("[]")
}

// ─── Normas migradas a BD (molde: Constitución Nacional) ──────────────────────

model norms {
  id                String                   @id
  number            String?
  title             String
  common_name       String?
  summary           String?
  category          String?
  categories        String[]                 @default([])
  year              Int?
  sanction_date     DateTime?                @db.Date
  promulgation_date DateTime?                @db.Date
  publication_date  DateTime?                @db.Date
  effective_date    DateTime?                @db.Date
  derogated_date    DateTime?                @db.Date
  bo_number         String?
  short_code        String?
  aliases           String[]                 @default([])
  is_destacada      Boolean?                 @default(false)
  infoleg_id_meta   String?
  status            String                   @default("VIGENTE")
  jurisdiction      String
  norm_type         String
  issuing_body      String?
  full_text         String?
  source_url        String?
  article_count     Int                      @default(0)
  executive_summary String?
  objective         String?
  problem_it_solves String?
  practical_impact  String?
  topics            String[]                 @default([])
  keywords          String[]                 @default([])
  related_norms     String[]                 @default([])
  affected_subjects String[]                 @default([])
  created_at        DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at        DateTime                 @default(now()) @db.Timestamptz(6)
  // En la BD es una columna GENERATED (setweight + immutable_unaccent); la crea
  // el baseline en prisma/migrations/. Prisma no soporta columnas generadas: al
  // introspectar produccion la representa como @default(dbgenerated(...)), y ese
  // default es invalido en Postgres porque referencia otras columnas
  //   ERROR: cannot use column reference in DEFAULT expression
  // Con el default declarado, el esquema deja de ser reproducible. Se declara
  // sin default a proposito. Ver la trampa en prisma/README.md: por esto todo
  // `migrate dev` genera un DROP DEFAULT espurio que hay que borrar a mano.
  search            Unsupported("tsvector")?
  annexes           annexes[]
  articles          articles[]
  norm_amendments   norm_amendments[]
  norm_metadata     norm_metadata?
  norm_relations    norm_relations[]
  norm_sections     norm_sections[]
  norm_titles       norm_titles[]
  segments          segments[]

  @@index([keywords], map: "idx_norms_keywords", type: Gin)
  @@index([search], map: "idx_norms_search", type: Gin)
  @@index([status], map: "idx_norms_status")
  @@index([topics], map: "idx_norms_topics", type: Gin)
  @@index([norm_type], map: "idx_norms_type")
}

model norm_metadata {
  norm_id          String   @id
  main_topic       String?
  subtopics        String[] @default([])
  related_laws     String[] @default([])
  regulations      String[] @default([])
  modifying_norms  String[] @default([])
  derogating_norms String[] @default([])
  jurisprudence    String[] @default([])
  doctrine         String[] @default([])
  obligations      String[] @default([])
  rights           String[] @default([])
  sanctions        String[] @default([])
  use_cases        String[] @default([])
  faq              Json?
  norms            norms    @relation(fields: [norm_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model norm_sections {
  id            String        @id
  norm_id       String
  number        String?
  name          String
  article_start Int?
  article_end   Int?
  ord           Float         @default(0)
  norms         norms         @relation(fields: [norm_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  norm_titles   norm_titles[]

  @@index([norm_id], map: "idx_sections_norm")
}

model norm_titles {
  id            String        @id
  section_id    String
  norm_id       String
  number        String?
  name          String
  article_start Int?
  article_end   Int?
  ord           Float         @default(0)
  norms         norms         @relation(fields: [norm_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  norm_sections norm_sections @relation(fields: [section_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([section_id], map: "idx_titles_section")
}

model articles {
  id                         String                   @id
  norm_id                    String
  number                     String
  title                      String?
  body                       String
  plain_language_explanation String?
  ord                        Float                    @default(0)
  status                     String?
  effective_date             DateTime?                @db.Date
  derogated_date             DateTime?                @db.Date
  practical_effects          String[]                 @default([])
  examples                   String[]                 @default([])
  related_articles           String[]                 @default([])
  jurisprudence              String[]                 @default([])
  regulations                String[]                 @default([])
  keywords                   String[]                 @default([])
  jurisprudence_refs         Json?
  visual_content             Json?
  // Columna GENERATED en la BD — misma razon que norms.search (ver ahi).
  search                     Unsupported("tsvector")?
  article_amendments         article_amendments[]
  norms                      norms                    @relation(fields: [norm_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  segments                   segments[]

  @@index([norm_id], map: "idx_articles_norm")
  @@index([search], map: "idx_articles_search", type: Gin)
}

model segments {
  id                String   @id
  article_id        String
  norm_id           String
  article_number    String?
  segment_type      String
  body              String
  plain_explanation String?
  practical_example String?
  refs              String[] @default([])
  ord               Float    @default(0)
  articles          articles @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  norms             norms    @relation(fields: [norm_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([article_id], map: "idx_segments_article")
  @@index([norm_id], map: "idx_segments_norm")
}

model article_amendments {
  id             String    @id
  article_id     String
  modifying_law  String?
  modifying_date DateTime? @db.Date
  previous_text  String?
  new_text       String?
  description    String?
  created_at     DateTime? @db.Timestamptz(6)
  articles       articles  @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([article_id], map: "idx_art_amend_article")
}

model norm_amendments {
  id             String    @id
  norm_id        String
  modifying_law  String?
  modifying_date DateTime? @db.Date
  description    String
  type           String?
  created_at     DateTime? @db.Timestamptz(6)
  norms          norms     @relation(fields: [norm_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([norm_id], map: "idx_norm_amend_norm")
}

model annexes {
  id      String  @id
  norm_id String
  number  String?
  title   String?
  content String
  ord     Float   @default(0)
  norms   norms   @relation(fields: [norm_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([norm_id], map: "idx_annexes_norm")
}

model norm_relations {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source_id    String
  target_id    String
  type         String
  description  String?
  target_label String?
  norms        norms   @relation(fields: [source_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([source_id, target_id, type])
  @@index([source_id], map: "idx_relations_source")
  @@index([target_id], map: "idx_relations_target")
}

// Normas referenciadas pero NO cargadas en detalle. Hacen clickeables las
// referencias inline (nombre completo + link a InfoLeg) sin cargar el articulado.
// Antes vivían hardcodeadas en src/data/norm-stubs.ts (+ espejo en el front).
model norm_stubs {
  number     String   @id
  name       String
  infoleg_id String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@map("norm_stubs")
}

// Categorías temáticas (slug, etiqueta, descripción, icono). Antes estaban
// duplicadas y divergentes: CATEGORY_LABELS en laws.service (back) y CATEGORIES
// en app/lib/categories.ts (front). Fuente única ahora.
model categories {
  slug        String    @id
  label       String
  description String?
  icon        String?
  ord         Int?      @default(0)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@map("categories")
}

// ─── Cuentas de usuario ───────────────────────────────────────────────────────
// Sistema de usuarios (registro/login). Toda la seguridad vive en NestJS.
// Clave natural de identidad = email (en minúsculas), para unificar a futuro con
// leads/founders/pagos. Ver docs/sistema-usuarios.html.

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String    @unique
  passwordHash   String    @map("password_hash")
  nombre         String?
  // Perfil opcional (se completa en registro o en /cuenta; nada es obligatorio).
  apellido       String?
  telefono       String?
  tipoUsuario    String?   @map("tipo_usuario") // abogado | estudiante | judicial | empresa | periodista | ciudadano | otro
  profesion      String?
  especialidad   String?   // rama/área en la que se especializa (ej. laboral, penal)
  empresa        String?
  provincia      String?
  status         String    @default("active") // active | suspended | closed
  isAdmin        Boolean   @default(false) @map("is_admin")
  isFounder      Boolean   @default(false) @map("is_founder")
  plan           String    @default("free") // free | pro
  planUntil      DateTime? @map("plan_until") @db.Timestamptz(6)
  guestId        String?   @map("guest_id") // migración guest → usuario
  leadId         String?   @map("lead_id") @db.Uuid
  founderId      String?   @map("founder_id") @db.Uuid
  consentAt      DateTime? @map("consent_at") @db.Timestamptz(6)
  consentVersion String?   @map("consent_version")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(6)
  // Fuerza bruta por CUENTA. El límite por IP no alcanza: un ataque distribuido
  // sobre un solo email usa una IP distinta por intento y nunca toca ese techo.
  failedLoginCount Int      @default(0) @map("failed_login_count")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)
  sessions       Session[]
  savedLaws      SavedLaw[]
  likes          LawLike[]
  folders        Folder[]
  benefitClaims  BenefitClaim[]

  @@index([guestId], map: "idx_users_guest")
  @@index([founderId], map: "idx_users_founder")
  @@map("users")
}

// Un refresh token = una fila. Guarda solo el sha256 del token opaco, nunca el
// token en claro. Habilita rotación, revocación y "cerrar todas las sesiones".
model Session {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt   DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  device       String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_sessions_user")
  @@index([expiresAt], map: "idx_sessions_expires")
  @@map("sessions")
}

// Leyes guardadas (favoritos). A nivel norma: el ícono de guardar en la ficha de
// ley y en la página de artículo guarda la norma entera. Ver docs/sistema-usuarios.html.
model SavedLaw {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  normId    String   @map("norm_id")
  nota      String?
  folderId  String?  @map("folder_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([userId, normId])
  @@index([userId], map: "idx_saved_laws_user")
  @@index([folderId], map: "idx_saved_laws_folder")
  @@map("saved_laws")
}

// "Me gusta". articleId = '' → like a la norma entera; con valor → a un artículo.
// El '' (en vez de NULL) hace que el unique funcione para los likes de norma.
model LawLike {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  normId    String   @map("norm_id")
  articleId String   @default("") @map("article_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, normId, articleId])
  @@index([userId], map: "idx_law_likes_user")
  @@index([normId], map: "idx_law_likes_norm")
  @@map("law_likes")
}

// Reclamo "doné y no aparece". El admin lo verifica en MercadoPago (mismo flujo
// de 2 niveles que ya existe) y aprueba el beneficio. Sin relación Prisma a users
// (solo el scalar user_id + FK en la BD) para no acoplar el modelo User.
model BenefitClaim {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  email          String
  monto          String?
  fecha          String?
  medio          String?
  detalle        String?
  comprobanteUrl String?  @map("comprobante_url")
  status         String   @default("pendiente") // pendiente | verificado | rechazado
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_benefit_claims_status")
  @@index([userId], map: "idx_benefit_claims_user")
  @@map("benefit_claims")
}

// Carpetas para organizar leyes guardadas. Límite de cantidad por plan
// (free/pro/pro+), sin límite para admin — ver FoldersService.
model Folder {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  name      String
  ord       Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  savedLaws SavedLaw[]

  @@index([userId], map: "idx_folders_user")
  @@map("folders")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tablas que existian en produccion pero que Prisma no conocia (6-ago-2026).
//
// Eran 12 de las 43. Su DDL vivia SOLO dentro de Supabase: no estaba en este
// archivo ni en supabase/migrations/. Consecuencia practica: `db-local.ps1`
// armaba una base local con 31 tablas y el runtime pedia 43, asi que /mapa-legal
// se quedaba sin recorridos (tours.service.ts los cachea a [] cuando la tabla no
// existe, ver el try/catch) y todo el panel de admin fallaba en local.
//
// Tipadas desde el DDL real del baseline (00000000000000_baseline). Al agregarlas
// aca, `prisma db push` y `prisma migrate` producen una base local COMPLETA.
// ─────────────────────────────────────────────────────────────────────────────

// Recorridos guiados del mapa legal. Antes vivian en tours.ts (codigo); se
// movieron a la BD para poder editarlos sin deploy.
model Tour {
  id          String     @id
  title       String
  hook        String
  emoji       String?
  accent      String?
  cardHook    String?    @map("card_hook")
  comingSoon  Boolean    @default(false) @map("coming_soon")
  layout      String?
  ord         Int        @default(0)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  steps       TourStep[]

  @@map("tours")
}

model TourStep {
  id     String  @id
  tourId String  @map("tour_id")
  lawId  String  @map("law_id")
  titulo String
  say    String
  via    String?
  scale  Float?
  durMs  Int?    @map("dur_ms")
  ord    Int
  tour   Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tourId, ord], map: "tour_steps_tour_idx")
  @@map("tour_steps")
}

// Pagos de Mercado Pago. `monto` es numeric en la BD: se mapea a Decimal para no
// perder centavos (Float redondearia).
model Pago {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime? @map("updated_at") @db.Timestamptz(6)
  tipo              String    @default("apoyo")
  concepto          String?
  monto             Decimal   @db.Decimal
  estado            String    @default("pendiente")
  mpPaymentId       String?   @map("mp_payment_id")
  mpStatus          String?   @map("mp_status")
  mpStatusDetail    String?   @map("mp_status_detail")
  paymentMethod     String?   @map("payment_method")
  email             String?
  nombre            String?
  guestId           String?   @map("guest_id")
  leadId            String?   @map("lead_id") @db.Uuid
  founderId         String?   @map("founder_id") @db.Uuid
  device            String?
  utmSource         String?   @map("utm_source")
  utmMedium         String?   @map("utm_medium")
  utmCampaign       String?   @map("utm_campaign")
  metadata          Json?
  externalReference String?   @map("external_reference")

  @@index([createdAt(sort: Desc)], map: "idx_pagos_created_at")
  @@index([estado], map: "idx_pagos_estado")
  @@index([guestId], map: "idx_pagos_guest")
  @@index([mpPaymentId], map: "idx_pagos_mp_payment_id")
  @@map("pagos")
}

model ProductOrder {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  producto       String
  nombre         String?
  email          String?
  telefono       String?
  precio         Decimal?  @db.Decimal
  detalle        Json?
  status         String    @default("pendiente")
  utmSource      String?   @map("utm_source")
  utmMedium      String?   @map("utm_medium")
  utmCampaign    String?   @map("utm_campaign")
  notas          String?
  guestId        String?   @map("guest_id")
  consentAt      DateTime? @map("consent_at") @db.Timestamptz(6)
  consentVersion String?   @map("consent_version")

  @@map("product_orders")
}

// Seguimiento de posteos: m24/m48 guardan las metricas a 24 y 48 horas.
model ContentPost {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  red         String   @default("twitter")
  categoria   String
  leyTema     String?  @map("ley_tema")
  angulo      String?
  utm         String?
  texto       String   @default("")
  link        String?
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  m24         Json?
  m48         Json?
  notas       String?

  @@index([publishedAt(sort: Desc)], map: "idx_content_posts_published")
  @@map("content_posts")
}

// Recorrido congelado de un visitante. Se arma en el rollup diario y permite
// purgar tracking_events sin perder la historia.
model UserJourney {
  guestId      String    @id @map("guest_id")
  contactEmail String?   @map("contact_email")
  firstTouch   Json?     @map("first_touch")
  timeline     Json      @default("[]")
  sessions     Int       @default(0)
  total        Int       @default(0)
  firstAt      DateTime? @map("first_at") @db.Timestamptz(6)
  lastAt       DateTime? @map("last_at") @db.Timestamptz(6)
  frozenAt     DateTime  @default(now()) @map("frozen_at") @db.Timestamptz(6)

  @@map("user_journeys")
}

// Metricas ya calculadas por dia. `frozen` marca los dias cerrados, que no se
// recalculan aunque se purguen los eventos crudos.
model MetricsDaily {
  day         DateTime @id @db.Date
  payload     Json
  guestIds    Json?    @map("guest_ids")
  eventsCount Int      @default(0) @map("events_count")
  frozen      Boolean  @default(false)
  computedAt  DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  @@map("metrics_daily")
}

// Snapshot server-side de las metricas por rango. Al agregar un campo a
// computeMetrics hay que subir SNAPSHOT_SCHEMA_VERSION o el panel sirve datos viejos.
model MetricsSnapshot {
  rangeKey      String   @id @map("range_key")
  payload       Json
  computedAt    DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)
  eventsInRange Int?     @default(0) @map("events_in_range")
  eventsAllTime Int?     @default(0) @map("events_all_time")

  @@map("metrics_snapshots")
}

// Clave/valor del panel (ej. "ultima vez que mire los contactos").
model AdminKv {
  key       String    @id
  value     String?
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("admin_kv")
}

model AdminDoc {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique(map: "admin_docs_key_key")
  content   Json     @default("{}")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("admin_docs")
}

// Healthcheck de /admin/sistema: un snapshot por hora de front/back/BD.
model SystemHealth {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  payload   Json

  @@index([checkedAt(sort: Desc)], map: "idx_system_health_checked")
  @@map("system_health")
}

// Triage de /admin/pendientes: resolver o anotar POR problema, no por evento.
model IssueTriage {
  issueKey  String   @id @map("issue_key")
  kind      String
  detail    String
  status    String   @default("pendiente") // pendiente | resuelto | ignorado
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("issue_triage")
}

// Anotador de pendientes del panel (/admin/tareas): lo que se va encontrando
// mientras se revisa el sitio, para no perderlo.
//
// A propósito NO es un gestor de proyectos. Una tarea es un texto y si está
// hecha o no — sin asignados, etiquetas, vencimientos ni prioridades. Si algún
// día hace falta más, que sea una decisión explícita y no una acumulación.
model AdminTask {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  texto     String
  hecha     Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  hechaAt   DateTime? @map("hecha_at") @db.Timestamptz(6)

  @@index([hecha, createdAt(sort: Desc)], map: "idx_admin_tasks_hecha")
  @@map("admin_tasks")
}
