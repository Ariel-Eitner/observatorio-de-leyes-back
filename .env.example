DATABASE_URL="postgresql://user:password@localhost:5432/observatorio_leyes?schema=public"
PORT=3600
NODE_ENV=development

# Contra que base corre este proceso: production | development.
# Si no se setea se infiere del host del DATABASE_URL y, ante la duda, asume
# produccion. El proceso lo avisa al arrancar. OJO: hoy el docker-compose local
# recibe el DATABASE_URL de produccion, asi que probar en local ES probar en prod.
DB_ENV=development

# Habilita las operaciones que borran datos en masa (DELETE /api/events).
# Dejar en false salvo en el entorno donde de verdad quieras poder vaciar.
ALLOW_DESTRUCTIVE=false

# Mercado Pago
MP_ACCESS_TOKEN=
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# ── Auth / sistema de usuarios ────────────────────────────────────────────────
# Gate de entorno: solo con AUTH_ENABLED=true responden los endpoints /api/auth/*.
# En produccion dejar SIN setear (o 'false') para desplegar el codigo sin exponer
# registro/login. Ver docs/sistema-usuarios.html.
AUTH_ENABLED=false
JWT_ACCESS_SECRET=          # secreto fuerte, distinto por entorno (48+ bytes)
JWT_ACCESS_TTL=15m          # vida del access token
REFRESH_TTL_DAYS=30         # vida deslizante del refresh token
# Super-admins fijos: emails (separados por coma) que SIEMPRE son admin al
# registrarse/loguearse. Fuente de verdad del admin; no se otorga desde afuera.
ADMIN_EMAILS=
